# The full URL of your deployed backend (no trailing slash).
# On Netlify: set this in Site Settings → Environment Variables.
# Example: VITE_API_URL=https://your-app-name.up.railway.app
#
# Leave this UNSET (or blank) for local development - Vite's proxy in
# vite.config.js will forward /api requests to http://localhost:4000 automatically.
VITE_API_URL=
